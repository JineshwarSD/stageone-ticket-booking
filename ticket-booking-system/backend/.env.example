# Database (SQLite file - no external DB server needed)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
CLIENT_URL="http://localhost:5173"

# Seat hold TTL in minutes
SEAT_HOLD_TTL_MINUTES=10

# Waitlist offer time-limit in minutes (time a waitlisted customer has to complete booking)
WAITLIST_OFFER_TTL_MINUTES=15

# Email (SMTP). Leave blank to auto-use an Ethereal test inbox (emails are NOT
# really delivered but you get a preview URL logged in the console - perfect
# for a college project demo). Fill these in with a real provider
# (Gmail app password, Brevo, Mailtrap, SendGrid free tier, etc.) to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ticket Booking <no-reply@ticketbooking.com>"
